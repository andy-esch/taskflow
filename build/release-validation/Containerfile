FROM golang:1.26.6-bookworm

ARG GOLANGCI_LINT_VERSION=v2.12.2
ARG GORELEASER_VERSION=v2.16.0
ARG GOVULNCHECK_VERSION=v1.6.0

RUN apt-get update \
    && apt-get install --yes --no-install-recommends ca-certificates git \
    && rm -rf /var/lib/apt/lists/*
RUN GOBIN=/usr/local/bin go install github.com/golangci/golangci-lint/v2/cmd/golangci-lint@${GOLANGCI_LINT_VERSION} \
    && GOBIN=/usr/local/bin go install github.com/goreleaser/goreleaser/v2@${GORELEASER_VERSION} \
    && GOBIN=/usr/local/bin go install golang.org/x/vuln/cmd/govulncheck@${GOVULNCHECK_VERSION}

RUN groupadd --gid 10001 validator \
    && useradd --uid 10001 --gid validator --create-home validator \
    && mkdir -p /cache/go-build /cache/go-mod /work \
    && chown -R validator:validator /cache /work

ENV GOCACHE=/cache/go-build
ENV GOMODCACHE=/cache/go-mod

COPY scripts/release-validate-container-entrypoint.sh /usr/local/bin/taskflow-release-validate
RUN chmod 0755 /usr/local/bin/taskflow-release-validate

USER validator:validator
WORKDIR /work
ENTRYPOINT ["taskflow-release-validate"]
