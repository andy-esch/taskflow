            "type": "string"
          },
          "type": "array"
        },
        "thread_statuses": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "audit_buckets": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "finding_statuses": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "criterion_states": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "description": "CriterionStates are the non-binary acceptance-criterion states — the words legal as a\n`· **\u003cstate\u003e:** \u003creason\u003e` suffix beside a checkbox. Published for the same reason\nfinding_statuses is: `CriterionJSON.state` has carried one of these since 1.46, and\nwithout the set an agent had to trigger an error and parse prose to learn it."
        },
        "task_fields": {
          "items": {
            "$ref": "#/$defs/SchemaField"
          },
          "type": "array"
        },
        "epic_fields": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "research_fields": {
          "items": {
            "$ref": "#/$defs/SchemaField"
          },
          "type": "array",
          "description": "ResearchFields mirrors TaskFields for research docs. Added because `research set`\ngates unknown keys on a field registry, and without this an agent had to trigger an\nerror and parse prose to learn the set — the same reason epic_fields was added when\n`epic set` landed. Which of these are WRITABLE is narrower: see `schema research`,\nwhose conventions name the protected ones."
        },
        "exit_codes": {
          "items": {
            "$ref": "#/$defs/SchemaExitCode"
          },
          "type": "array"
        },
        "kinds": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "schema_version",
        "statuses",
        "epic_statuses",
        "thread_statuses",
        "audit_buckets",
        "finding_statuses",
        "criterion_states",
        "task_fields",
        "epic_fields",
        "research_fields",
        "exit_codes",
        "kinds"
      ],
      "description": "SchemaEnvelope is `schema --json` (the global contract)."
    },
