        "workspace"
      ],
      "description": "WorkspaceEnvelope is `workspace --json`: the cheap read that answers \"which planning tree would a mutation hit from here?\" before running one."
    },
    "WorkspaceJSON": {
      "properties": {
        "planning_root": {
          "type": "string"
        },
        "space": {
          "type": "string",
          "description": "Space is the LOCAL registry label that explicitly selected this entry point via\n--space or TSKFLW_SPACE. It is omitted for ordinary -C/cwd discovery. Unlike\nRepoID it is machine-local and checkout-specific; the two must not be conflated."
        },
        "repo_id": {
          "type": "string",
          "description": "RepoID is the planning repo's DURABLE identity — stable across moves, and shared by\nevery worktree of the repo (it lives in a committed file). Omitted for a repo that\npredates the mint. Pair it with PlanningRoot, never substitute: the id names the\nrepo, the path names the checkout."
        },
        "branch": {
          "type": "string",
          "description": "Branch and Checkout identify WHICH working tree, where RepoID identifies which repo:\nevery worktree of a repo shares one id, so two of them are told apart only by these.\nBoth omitted when the tree is not in a git repo, which is a normal way to keep\nplanning. Checkout is \"base\" or \"worktree\"."
        },
        "checkout": {
          "type": "string",
          "description": "base|worktree"
        },
        "config_path": {
          "type": "string"
        },
        "source": {
          "type": "string",
          "description": "how the root was selected: pointer|config|discovered"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "planning_root",
        "source"
      ],
      "description": "WorkspaceJSON identifies the planning tree a command resolved to."
    },
