    "FieldDoc": {
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "description": {
          "type": "string"
        },
        "example": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "name",
        "type",
        "required",
        "description",
        "example"
      ],
      "description": "FieldDoc documents one *authoring* field: the human/agent-set frontmatter a well-formed document declares."
    },
    "FileProblem": {
      "properties": {
        "path": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "path",
        "message"
      ],
      "description": "FileProblem is a non-fatal per-file load problem: the file was skipped, with an actionable message explaining what's wrong and how to fix it."
    },
    "FindingJSON": {
      "properties": {
        "audit": {
          "type": "string",
          "description": "slug of the audit this finding belongs to"
        },
        "bucket": {
          "type": "string",
          "description": "the audit's bucket — open | closed | deferred"
        },
        "code": {
          "type": "string",
          "description": "finding code within the audit (H1/M2/S3…)"
        },
        "title": {
          "type": "string",
          "description": "finding title"
        },
        "status": {
          "type": "string",
          "description": "open | in-progress | fixed | tracked | deferred | superseded | wontfix"
        },
        "file": {
          "type": "string",
          "description": "file:line the finding refers to"
        },
        "component": {
          "type": "string",
          "description": "component/subsystem"
        },
        "effort": {
          "type": "string",
          "description": "XS | S | M | L"
        },
        "urgency": {
          "type": "string",
          "description": "acute | soon | eventually"
        },
        "status_decoration": {
          "type": "string",
          "description": "everything after the status word — the date"
        },
        "note": {
          "type": "string",
          "description": "the finding's resolution paragraph — how it was resolved; absent when it carries none"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "audit",
        "bucket",
        "code",
        "title",
        "status"
      ],
      "description": "FindingJSON is the wire shape of one audit finding."
    },
    "FindingsEnvelope": {
      "properties": {
        "schema_version": {
          "type": "string"
        },
        "findings": {
          "items": {
            "$ref": "#/$defs/FindingJSON"
          },
          "type": "array"
        },
        "unreadable": {
          "items": {
            "$ref": "#/$defs/FileProblem"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "schema_version",
        "findings"
      ],
      "description": "FindingsEnvelope is `audit findings --json` (the finding-level query)."
    },
    "FindingsRollupJSON": {
      "properties": {
        "open": {
          "type": "integer",
          "description": "actionable findings with status open"
        },
        "in_progress": {
          "type": "integer",
          "description": "actionable findings with status in-progress"
        },
        "by_urgency": {
          "items": {
            "$ref": "#/$defs/CountByJSON"
          },
          "type": "array",
          "description": "breakdown by urgency (acute"
        },
        "by_component": {
          "items": {
            "$ref": "#/$defs/CountByJSON"
          },
          "type": "array",
          "description": "breakdown by top-level component"
        },
        "acute": {
          "items": {
            "$ref": "#/$defs/FindingJSON"
          },
          "type": "array",
          "description": "the acute findings"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "open",
        "in_progress"
      ],
      "description": "FindingsRollupJSON aggregates the actionable audit findings (status open or in-progress) across all audits — the `status` summary's \"audit findings\" view."
    },
    "FindingsTallyJSON": {
      "properties": {
        "total": {
          "type": "integer",
          "description": "total findings parsed from the audit body"
        },
        "open": {
          "type": "integer",
          "description": "findings whose status is open"
        },
        "in_progress": {
          "type": "integer",
          "description": "findings whose status is in-progress"
        },
        "done": {
          "type": "integer",
          "description": "findings whose status is fixed or tracked"
        },
        "dropped": {
          "type": "integer",
          "description": "findings whose status is deferred"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "total",
        "open",
        "in_progress",
        "done",
        "dropped"
      ],
      "description": "FindingsTallyJSON is an audit's finding disposition tally (the `findings` field of `audit info`) — the audit analogue of a task's acceptance-criteria tally."
    },
    "FixEnvelope": {
      "properties": {
        "schema_version": {
          "type": "string"
        },
        "dry_run": {
          "type": "boolean"
        },
        "fixed": {
          "items": {
            "$ref": "#/$defs/FixResult"
          },
          "type": "array"
        },
        "unreadable": {
          "items": {
            "$ref": "#/$defs/FileProblem"
          },
          "type": "array"
        },
        "remaining": {
          "items": {
            "$ref": "#/$defs/LintTaskJSON"
          },
          "type": "array"
        },
        "workspace": {
          "$ref": "#/$defs/WorkspaceJSON",
          "description": "Workspace proves WHICH planning tree this receipt describes — see WorkspaceJSON."
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "schema_version",
        "dry_run",
        "fixed",
        "unreadable",
        "remaining",
        "workspace"
      ],
      "description": "FixEnvelope is `lint --fix --json`."
    },
    "FixResult": {
      "properties": {
        "path": {
          "type": "string"
        },
        "changes": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "skipped": {
          "type": "boolean",
          "description": "Skipped marks a file the pass deliberately did NOT repair, with Changes carrying the\nreason. Reported alongside repairs because the reason is the useful part — \"this id\nis still referenced by three files\" is what the operator has to act on — but counted\nseparately, since calling a refusal a fix is how a tool loses trust."
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "path",
        "changes"
      ],
      "description": "FixResult records the auto-repairs applied (or proposed) for one file."
    },
    "GraphProblemJSON": {
      "properties": {
        "code": {
          "type": "string"
        },
        "task_id": {
          "type": "string"
        },
        "related_task_id": {
