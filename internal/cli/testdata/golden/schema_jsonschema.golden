    },
    "ThreadViewJSON": {
      "properties": {
        "thread": {
          "$ref": "#/$defs/ThreadJSON"
        },
        "rollup": {
          "$ref": "#/$defs/ThreadRollupJSON"
        },
        "graph_health": {
          "type": "string",
          "description": "repository task-DAG verdict: healthy|degraded|broken"
        },
        "projection_health": {
          "type": "string",
          "description": "Thread-local evidence verdict after combining graph and document integrity: healthy|degraded|broken"
        },
        "inconsistent": {
          "type": "boolean",
          "description": "true when a completed Thread is not soundly closed"
        },
        "members": {
          "items": {
            "$ref": "#/$defs/ThreadTaskJSON"
          },
          "type": "array"
        },
        "external_gates": {
          "items": {
            "$ref": "#/$defs/ThreadExternalGateJSON"
          },
          "type": "array",
          "description": "direct prerequisites outside the Thread membership boundary; deeper upstream context is available through causal blocker queries"
        },
        "frontier": {
          "items": {
            "$ref": "#/$defs/ThreadTaskJSON"
          },
          "type": "array",
          "description": "next-up and ready-to-start Thread members with clear dependency gates; empty unless both graph_health and projection_health are healthy"
        },
        "problems": {
          "items": {
            "$ref": "#/$defs/ThreadProblemJSON"
          },
          "type": "array"
        },
        "graph_problems": {
