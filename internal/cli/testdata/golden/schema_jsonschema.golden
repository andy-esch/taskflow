{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/andy-esch/taskflow/internal/wire/json-envelopes",
  "$ref": "#/$defs/jsonEnvelopes",
  "$defs": {
    "ACJSON": {
      "properties": {
        "checked": {
          "type": "integer",
          "description": "acceptance criteria currently checked (- [x])"
        },
        "total": {
          "type": "integer",
          "description": "total acceptance criteria in the task's acceptance-criteria section"
        },
        "explained": {
          "type": "integer",
          "description": "Explained is how many UNMET criteria state why — any of the non-binary criterion\nstates (see domain.CriterionSuffixStates). Zero for\nevery task written before the criterion vocabulary existed. Schema 1.45."
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "checked",
        "total"
      ],
      "description": "ACJSON is a task's acceptance-criteria checkbox tally (the `ac` field of `task info`): how many criteria are checked out of the total."
    },
    "AcceptanceEnvelope": {
      "properties": {
        "schema_version": {
          "type": "string"
        },
        "slug": {
          "type": "string"
        },
        "acceptance": {
          "items": {
            "$ref": "#/$defs/CriterionJSON"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "schema_version",
        "slug",
        "acceptance"
      ],
      "description": "AcceptanceEnvelope wraps `task ac --list --json` — a task's acceptance criteria with their checked state (the list an agent flips by index)."
    },
    "AuditInfoEnvelope": {
      "properties": {
        "schema_version": {
          "type": "string"
        },
        "audit_info": {
          "$ref": "#/$defs/AuditInfoJSON"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "schema_version",
        "audit_info"
      ],
      "description": "AuditInfoEnvelope wraps `audit info --json` — the token-cheap audit metadata read (path + bucket + finding tally, no body), the audit counterpart to TaskInfoEnvelope."
    },
    "AuditInfoJSON": {
      "properties": {
        "id": {
          "type": "string",
          "description": "stable identifier — absent on audits created before id assignment"
        },
        "slug": {
          "type": "string",
          "description": "audit slug (filename without .md)"
        },
        "bucket": {
          "type": "string",
          "description": "open | closed | deferred — authoritative from frontmatter (ADR-0003 §4)"
        },
        "path": {
          "type": "string",
          "description": "absolute path to the audit's markdown file"
        },
        "findings": {
          "$ref": "#/$defs/FindingsTallyJSON",
          "description": "finding disposition tally"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "slug",
        "bucket",
        "path",
        "findings"
      ],
      "description": "AuditInfoJSON is the token-cheap metadata read for an audit (`audit info`): where the file lives, its bucket, and the finding tally — no body."
    },
    "AuditJSON": {
      "properties": {
        "id": {
          "type": "string",
          "description": "stable identifier — the immutable key; absent on audits created before id assignment"
        },
        "slug": {
          "type": "string",
          "description": "audit slug (filename without .md) — the human handle"
        },
        "bucket": {
          "type": "string",
          "description": "open | closed | deferred — authoritative"
        },
        "area": {
          "type": "string",
          "description": "subsystem/topic audited"
        },
        "date": {
          "type": "string",
          "description": "audit date YYYY-MM-DD (immutable — part of the slug)"
        },
        "updated_at": {
          "type": "string",
          "description": "audit's own last-edited date YYYY-MM-DD (edit/append); a bucket move does not change it"
        },
        "findings": {
          "type": "integer",
          "description": "total findings parsed from the body"
        },
        "open_findings": {
          "type": "integer",
          "description": "findings whose status is open"
        },
        "in_progress_findings": {
          "type": "integer",
          "description": "findings whose status is in-progress"
        },
        "done_findings": {
          "type": "integer",
          "description": "findings whose status is fixed or tracked (the bar's done band)"
        },
        "dropped_findings": {
          "type": "integer",
          "description": "findings whose status is deferred"
        },
        "ready_to_close": {
          "type": "boolean",
          "description": "true when an open audit has no open/in-progress findings left (ready to close)"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "slug",
        "bucket",
        "findings",
        "open_findings",
        "in_progress_findings",
        "done_findings",
        "dropped_findings"
      ],
      "description": "AuditJSON is the wire shape of an audit inside the --json envelopes."
    },
    "AuditMutationEnvelope": {
      "properties": {
        "schema_version": {
          "type": "string"
        },
        "dry_run": {
          "type": "boolean"
        },
        "audit": {
          "$ref": "#/$defs/AuditJSON"
        },
        "body": {
          "type": "string"
        },
        "workspace": {
          "$ref": "#/$defs/WorkspaceJSON",
          "description": "Workspace proves WHICH planning tree this receipt describes — see WorkspaceJSON."
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "schema_version",
        "dry_run",
        "audit",
        "workspace"
      ],
      "description": "AuditMutationEnvelope is `audit append --json`: the reloaded audit, dry_run, and the resulting body — the audit counterpart to TaskMutationEnvelope."
    },
    "AuditShowEnvelope": {
      "properties": {
        "schema_version": {
          "type": "string"
        },
        "audit": {
          "$ref": "#/$defs/AuditJSON"
        },
        "body": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "schema_version",
        "audit",
        "body"
      ],
      "description": "AuditShowEnvelope is `audit show --json`."
    },
    "AuditsEnvelope": {
      "properties": {
        "schema_version": {
          "type": "string"
        },
        "audits": {
          "items": {
            "$ref": "#/$defs/AuditJSON"
          },
          "type": "array"
        },
        "unreadable": {
          "items": {
            "$ref": "#/$defs/FileProblem"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "schema_version",
        "audits"
      ],
      "description": "AuditsEnvelope is `audit list --json`."
    },
    "BoardColumnJSON": {
      "properties": {
        "status": {
          "type": "string"
        },
        "tasks": {
          "items": {
            "$ref": "#/$defs/TaskJSON"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "status",
        "tasks"
      ],
      "description": "BoardColumnJSON is one status column of the board."
    },
    "BoardEnvelope": {
      "properties": {
        "schema_version": {
          "type": "string"
        },
        "columns": {
          "items": {
            "$ref": "#/$defs/BoardColumnJSON"
          },
          "type": "array"
        },
        "unreadable": {
          "items": {
            "$ref": "#/$defs/FileProblem"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "schema_version",
        "columns"
      ],
      "description": "BoardEnvelope is `board --json`: the active-work pipeline, tasks grouped by status."
    },
    "ConfigBoolValueJSON": {
      "properties": {
        "value": {
          "type": "boolean"
        },
        "source": {
          "type": "string",
          "description": "flag|repository|user|default"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "value",
        "source"
      ]
    },
    "ConfigEffectiveJSON": {
      "properties": {
        "theme": {
          "$ref": "#/$defs/ConfigStringValueJSON"
        },
        "pager_enabled": {
          "$ref": "#/$defs/ConfigBoolValueJSON"
        },
        "pager_command": {
          "$ref": "#/$defs/ConfigStringValueJSON"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "theme",
        "pager_enabled",
        "pager_command"
      ]
    },
    "ConfigEnvelope": {
      "properties": {
        "schema_version": {
          "type": "string"
        },
        "repository": {
          "$ref": "#/$defs/ConfigRepositoryJSON"
        },
        "user": {
          "$ref": "#/$defs/ConfigUserJSON"
        },
        "effective": {
          "$ref": "#/$defs/ConfigEffectiveJSON"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "schema_version",
        "repository",
        "user",
        "effective"
      ],
      "description": "ConfigEnvelope is `config` / `config show --json`: raw repository and user scopes beside the effective presentation values and their provenance."
    },
    "ConfigMigrationEnvelope": {
      "properties": {
        "schema_version": {
          "type": "string"
        },
        "dry_run": {
          "type": "boolean"
        },
        "changed": {
          "type": "boolean"
        },
        "config_path": {
          "type": "string"
        },
        "mode": {
          "type": "string",
          "description": "scaffold|pointer"
        },
        "steps": {
          "items": {
            "$ref": "#/$defs/ConfigMigrationStepJSON"
          },
          "type": "array"
        },
        "workspace": {
          "$ref": "#/$defs/WorkspaceJSON"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "schema_version",
        "dry_run",
        "changed",
        "config_path",
        "mode",
        "steps",
        "workspace"
      ],
      "description": "ConfigMigrationEnvelope is `config migrate --json`: the exact planned/applied changes."
    },
    "ConfigMigrationStepJSON": {
      "properties": {
        "kind": {
          "type": "string",
          "description": "repo-id|planning-repo-id"
        },
        "key": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "kind",
        "key",
        "value"
      ]
    },
    "ConfigPagerJSON": {
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "command": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "ConfigRepositoryJSON": {
      "properties": {
        "path": {
          "type": "string"
        },
        "dir": {
          "type": "string"
        },
        "planning_root": {
          "type": "string"
        },
        "mode": {
          "type": "string",
          "description": "scaffold|pointer|discovered"
        },
        "taskflow_root": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "planning_repo": {
          "type": "string"
        },
        "planning_repo_id": {
          "type": "string"
        },
        "tracked_repos": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "theme": {
          "$ref": "#/$defs/ConfigThemeJSON"
        },
        "pager": {
          "$ref": "#/$defs/ConfigPagerJSON"
        },
        "pending_migrations": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "migration_warning": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "planning_root",
        "mode",
        "tracked_repos",
        "theme",
        "pager",
        "pending_migrations"
      ]
    },
    "ConfigStringValueJSON": {
      "properties": {
        "value": {
          "type": "string"
        },
        "source": {
          "type": "string",
          "description": "flag|environment|repository|user|default"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "value",
        "source"
      ]
    },
    "ConfigThemeJSON": {
      "properties": {
        "name": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "ConfigUserJSON": {
      "properties": {
        "path": {
          "type": "string"
        },
        "exists": {
          "type": "boolean"
        },
        "theme": {
          "$ref": "#/$defs/ConfigThemeJSON"
        },
        "pager": {
          "$ref": "#/$defs/ConfigPagerJSON"
        },
        "warning": {
          "type": "string"
        },
        "registry_path": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "exists",
        "theme",
        "pager"
      ]
    },
    "CountByJSON": {
      "properties": {
        "key": {
          "type": "string",
          "description": "the urgency value or top-level component"
        },
        "count": {
          "type": "integer",
          "description": "actionable findings in this bucket"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "key",
        "count"
      ],
      "description": "CountByJSON is one bucket of a finding breakdown — an urgency value or a top-level component, and its count."
    },
    "CreatedEnvelope": {
      "properties": {
        "schema_version": {
          "type": "string"
        },
        "dry_run": {
          "type": "boolean"
        },
        "created": {
          "$ref": "#/$defs/CreatedItem"
        },
        "workspace": {
          "$ref": "#/$defs/WorkspaceJSON",
          "description": "Workspace proves WHICH planning tree this receipt describes — see WorkspaceJSON."
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "schema_version",
        "dry_run",
        "created",
        "workspace"
      ],
      "description": "CreatedEnvelope is `\u003centity\u003e new --json` — task, epic, audit, and research all emit it."
    },
    "CreatedItem": {
      "properties": {
        "kind": {
          "type": "string"
        },
        "id": {
          "type": "string",
          "description": "ID is the STABLE identifier (ADR-0003 §3) — the 12-char key that leads the\nfilename for task/audit/research, and the NN-slug for an epic, whose identity\nhas always been its number. This is the handle to store: it survives renames."
        },
        "slug": {
          "type": "string",
          "description": "Slug is the HUMAN, mutable name — it changes when the entity is renamed, so it\nis for display and for typing at a prompt, never for saving as a reference."
        },
        "status": {
          "type": "string"
        },
        "path": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "kind",
        "id",
        "slug",
        "status",
        "path"
      ],
      "description": "CreatedItem is the created document inside CreatedEnvelope."
    },
    "CriterionJSON": {
      "properties": {
        "index": {
          "type": "integer",
          "description": "1-based position of the criterion in the acceptance section"
        },
        "checked": {
          "type": "boolean",
          "description": "whether the checkbox is checked (- [x])"
        },
        "text": {
          "type": "string",
          "description": "the criterion text — the first line after the checkbox"
        },
        "state": {
          "type": "string",
          "description": "disposition beyond the checkbox — one of criterion_states in the schema contract; absent for a plain met/not-met criterion"
        },
        "reason": {
          "type": "string",
          "description": "why the criterion is deferred/wontfix/n-a — required for those states"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "index",
        "checked",
        "text"
      ],
      "description": "CriterionJSON is one acceptance-criteria checkbox for `task ac --list --json` — the list an agent then flips by index with `task ac --check/--uncheck`."
    },
    "DependencyEdgeOutcomeJSON": {
      "properties": {
        "dependent_id": {
          "type": "string"
        },
        "prerequisite_id": {
          "type": "string"
        },
        "action": {
          "type": "string"
        },
        "outcome": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "dependent_id",
        "prerequisite_id",
        "action",
        "outcome"
      ],
      "description": "DependencyEdgeOutcomeJSON is one canonical edge result in a mutation receipt."
    },
    "DependencyMutationEnvelope": {
      "properties": {
        "schema_version": {
          "type": "string"
        },
        "operation": {
          "type": "string"
        },
        "changed": {
          "type": "boolean"
        },
        "dry_run": {
          "type": "boolean"
        },
        "edges": {
          "items": {
            "$ref": "#/$defs/DependencyEdgeOutcomeJSON"
          },
          "type": "array"
        },
        "impacts": {
          "items": {
            "$ref": "#/$defs/TaskGraphStateImpactJSON"
          },
          "type": "array"
        },
        "cleared_legacy_fields": {
          "items": {
            "$ref": "#/$defs/LegacyFieldClearJSON"
          },
          "type": "array"
        },
        "planned_task_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "applied_task_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "remaining_task_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "workspace": {
          "$ref": "#/$defs/WorkspaceJSON"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "schema_version",
        "operation",
        "changed",
        "dry_run",
        "edges",
        "impacts",
        "cleared_legacy_fields",
        "planned_task_ids",
        "applied_task_ids",
        "remaining_task_ids",
        "workspace"
      ],
      "description": "DependencyMutationEnvelope is the successful `task depend` machine receipt."
    },
    "DependencyMutationJSON": {
      "properties": {
        "operation": {
          "type": "string"
        },
        "changed": {
          "type": "boolean"
        },
        "dry_run": {
          "type": "boolean"
        },
        "edges": {
          "items": {
            "$ref": "#/$defs/DependencyEdgeOutcomeJSON"
          },
          "type": "array"
        },
        "impacts": {
          "items": {
            "$ref": "#/$defs/TaskGraphStateImpactJSON"
          },
          "type": "array"
        },
        "cleared_legacy_fields": {
          "items": {
            "$ref": "#/$defs/LegacyFieldClearJSON"
          },
          "type": "array"
        },
        "planned_task_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "applied_task_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "remaining_task_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "workspace": {
          "$ref": "#/$defs/WorkspaceJSON"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "operation",
        "changed",
        "dry_run",
        "edges",
        "impacts",
        "cleared_legacy_fields",
        "planned_task_ids",
        "applied_task_ids",
        "remaining_task_ids",
        "workspace"
      ],
      "description": "DependencyMutationJSON is the reusable dependency-mutation receipt payload."
    },
    "DoctorEnvelope": {
      "properties": {
        "schema_version": {
          "type": "string"
        },
        "root": {
          "type": "string"
        },
        "problems": {
          "items": {
            "$ref": "#/$defs/DoctorProblem"
          },
          "type": "array"
        },
        "registry": {
          "$ref": "#/$defs/DoctorRegistry"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "schema_version",
        "root",
        "problems",
        "registry"
      ],
      "description": "DoctorEnvelope is `doctor --json`: the repo-local linkback audit plus the home space registry audit."
    },
    "DoctorProblem": {
      "properties": {
        "repo": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "repo",
        "message"
      ],
      "description": "DoctorProblem is one linkback inconsistency: the offending repo + a message."
    },
    "DoctorRegistry": {
      "properties": {
        "checked": {
          "type": "integer"
        },
        "problems": {
          "items": {
            "$ref": "#/$defs/DoctorSpaceProblem"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "checked",
        "problems"
      ],
      "description": "DoctorRegistry is the home-registry section of doctor output."
    },
    "DoctorSpaceProblem": {
      "properties": {
        "id": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "remedy": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "id",
        "path",
        "kind",
        "message",
        "remedy"
      ],
      "description": "DoctorSpaceProblem is one actionable registered-space diagnosis."
    },
    "EpicJSON": {
      "properties": {
        "id": {
          "type": "string",
          "description": "epic identifier (NN-slug)"
        },
        "status": {
          "type": "string",
          "description": "active | retired | deprecated"
        },
        "description": {
          "type": "string",
          "description": "one-line epic goal"
        },
        "priority": {
          "type": "string",
          "description": "high | medium | low"
        },
        "created": {
          "type": "string",
          "description": "creation date YYYY-MM-DD"
        },
        "updated_at": {
          "type": "string",
          "description": "epic's own last-edited date YYYY-MM-DD (set/edit/status-move); distinct from derived task activity"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "description": "topical tags"
        },
        "total": {
          "type": "integer"
        },
        "done": {
          "type": "integer"
        },
        "open": {
          "type": "integer",
          "description": "Open is the pending workload (total − done); 0 = nothing in flight."
        },
        "percent": {
          "type": "integer"
        },
        "deprecated": {
          "type": "integer",
          "description": "Deprecated is the withdrawn tasks, excluded from total/done."
        },
        "liveness": {
          "type": "string",
          "description": "derived activity: working | fresh | dormant"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "id",
        "total",
        "done",
        "open",
        "percent",
        "deprecated",
        "liveness"
      ],
      "description": "EpicJSON is epic list output: the shared meta (embedded, so `epic list` and `epic show` can't drift) plus the task rollup."
    },
    "EpicMetaJSON": {
      "properties": {
        "id": {
          "type": "string",
          "description": "epic identifier (NN-slug)"
        },
        "status": {
          "type": "string",
          "description": "active | retired | deprecated"
        },
        "description": {
          "type": "string",
          "description": "one-line epic goal"
        },
        "priority": {
          "type": "string",
          "description": "high | medium | low"
        },
        "created": {
          "type": "string",
          "description": "creation date YYYY-MM-DD"
        },
        "updated_at": {
          "type": "string",
          "description": "epic's own last-edited date YYYY-MM-DD (set/edit/status-move); distinct from derived task activity"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "description": "topical tags"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "id"
      ],
      "description": "EpicMetaJSON is the shared epic meta fields, embedded by EpicJSON (`epic list`) and emitted directly by `epic show` / `epic set`."
    },
    "EpicMutationEnvelope": {
      "properties": {
        "schema_version": {
          "type": "string"
        },
        "dry_run": {
          "type": "boolean"
        },
        "epic": {
          "$ref": "#/$defs/EpicMetaJSON"
        },
        "workspace": {
          "$ref": "#/$defs/WorkspaceJSON",
          "description": "Workspace proves WHICH planning tree this receipt describes — see WorkspaceJSON."
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "schema_version",
        "dry_run",
        "epic",
        "workspace"
      ],
      "description": "EpicMutationEnvelope is `epic set --json`: the reloaded epic + dry_run."
    },
    "EpicShowEnvelope": {
      "properties": {
        "schema_version": {
          "type": "string"
        },
        "epic": {
          "$ref": "#/$defs/EpicMetaJSON"
        },
        "tasks": {
          "items": {
            "$ref": "#/$defs/TaskJSON"
          },
          "type": "array"
        },
        "body": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "schema_version",
        "epic",
        "tasks",
        "body"
      ],
      "description": "EpicShowEnvelope is `epic show --json`."
    },
    "EpicsEnvelope": {
      "properties": {
        "schema_version": {
          "type": "string"
        },
        "epics": {
          "items": {
            "$ref": "#/$defs/EpicJSON"
          },
          "type": "array"
        },
        "unreadable": {
          "items": {
            "$ref": "#/$defs/FileProblem"
          },
          "type": "array"
